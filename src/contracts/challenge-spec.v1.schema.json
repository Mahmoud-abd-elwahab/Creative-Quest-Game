{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mahmoud-abd-elwahab.github.io/Creative-Quest-Game/contracts/challenge-spec.v1.schema.json",
  "title": "Creative Quest ChallengeSpecV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "slotId", "scenarioId", "worldId", "primarySkill", "secondarySkills", "difficultyBand", "cognitiveOperation", "interaction", "responseMode", "industry", "audience", "situation", "objective", "productTruths", "prompt", "evidence", "rubricVersion", "rubric", "feedbackByErrorCode", "hintTiers", "novelty"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,100}$"},
    "slotId": {"type": "string", "pattern": "^[A-Za-z0-9_-]+$"},
    "scenarioId": {"type": "string", "minLength": 3},
    "worldId": {"type": "string", "minLength": 2},
    "legacyLevelId": {"type": "integer", "minimum": 1, "maximum": 100},
    "primarySkill": {"$ref": "#/$defs/skill"},
    "secondarySkills": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/skill"}},
    "difficultyBand": {"type": "integer", "minimum": 1, "maximum": 5},
    "cognitiveOperation": {"type": "string", "minLength": 5},
    "interaction": {"enum": ["inspect", "connect", "arrange", "compare", "deflect", "route", "interview", "test", "forge", "boss-evidence", "boss-mirror", "boss-forge"]},
    "responseMode": {"enum": ["single-select", "multi-select", "order", "match", "structured-build", "open-rubric"]},
    "industry": {"type": "string", "minLength": 2},
    "audience": {"type": "string", "minLength": 2},
    "situation": {"type": "string", "minLength": 5},
    "objective": {"type": "string", "minLength": 5},
    "productTruths": {"type": "array", "items": {"type": "string", "minLength": 2}},
    "prompt": {"type": "string", "minLength": 5},
    "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "options": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/option"}},
    "validAnswerSets": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}},
    "rubricVersion": {"type": "string", "minLength": 2},
    "rubric": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rubric"}},
    "feedbackByErrorCode": {"type": "object", "additionalProperties": {"type": "string", "minLength": 5}},
    "hintTiers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "novelty": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "cognitiveSignature"], "properties": {"fingerprint": {"type": "string", "minLength": 5}, "cognitiveSignature": {"type": "string", "minLength": 5}, "reviewOf": {"type": "string", "minLength": 2}}}
  },
  "$defs": {
    "skill": {"enum": ["OBS", "AUD", "TEN", "INS", "BRAND", "TERR", "CON", "MECH", "DIR", "CAMP"]},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "text", "type", "source"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "text": {"type": "string", "minLength": 3},
        "type": {"enum": ["observation", "record", "hypothesis", "unknown"]},
        "source": {"enum": ["fictional", "user-provided", "externally-verified"]},
        "scope": {"type": "string"},
        "publicSource": {"type": "object", "additionalProperties": false, "required": ["url", "accessedOn"], "properties": {"url": {"type": "string", "format": "uri"}, "accessedOn": {"type": "string", "format": "date"}}}
      },
      "allOf": [
        {"if": {"properties": {"source": {"const": "externally-verified"}}, "required": ["source"]}, "then": {"required": ["publicSource"]}},
        {"if": {"properties": {"source": {"const": "fictional"}}, "required": ["source"]}, "then": {"not": {"required": ["publicSource"]}}}
      ]
    },
    "option": {"type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": {"id": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}, "errorCode": {"type": "string"}}},
    "rubric": {"type": "object", "additionalProperties": false, "required": ["id", "weight"], "properties": {"id": {"type": "string", "minLength": 2}, "weight": {"type": "integer", "minimum": 1, "maximum": 100}, "critical": {"type": "boolean"}}}
  }
}